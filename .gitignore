# Compiled class file
*.class

# Log file
*.log
# ...except YCSB's progress logs, which are part of the benchmark results
!m2/benchmark/raw/**/*.log
!m3/benchmark/raw/**/*.log

# Data folders of nodes run on a local machine (README, "Run it on your machine")
app/data/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

.idea/
